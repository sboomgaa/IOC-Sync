# ============================================================
# Defender XDR → Check Point IOC Management
# Configuration File (POC mode — inline secrets)
# ============================================================

azure:
  tenant_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  client_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  client_secret: "your-defender-client-secret"

api:
  token_url_template: "https://login.microsoftonline.com/{tenant_id}/oauth2/v2.0/token"
  indicator_url: "https://api.securitycenter.microsoft.com/api/indicators"
  scope: "https://api.securitycenter.microsoft.com/.default"
  request_timeout_seconds: 60
  # Check Point IOC API rate limit is 50 requests/minute per Swagger.
  rate_limit_delay_seconds: 1.2

checkpoint:
  enabled: true
  # Configured for the Canadian Portal - update if using a different geo
  auth_url: "https://cloudinfra-gw.ca.portal.checkpoint.com"
  api_base_url: "https://cloudinfra-gw.ca.portal.checkpoint.com/app/ioc-management"
  client_id: "your-checkpoint-client-id"
  access_key: "your-checkpoint-access-key"

  feed_name: "MSDefender_Autofeed"

  batch_size: 100
  default_severity: "High"          # "Low"|"Medium"|"High"|"Critical" or 0..100
  default_confidence: "High"        # "Low"|"Medium"|"High"            or 0..100

  # Expiration handling:
  #   preserve_defender_expiration: true (default)
  #     -> ttl_in_days is computed from each IOC's Defender expirationTime
  #        so Check Point expires it on the same date Defender intends.
  #   preserve_defender_expiration: false
  #     -> every IOC uses the fixed expiration_days value below.
  # expiration_days is ALSO the fallback when Defender has no expiration,
  # the value is unparseable, or it is already in the past.
  preserve_defender_expiration: true
  expiration_days: 30               # maps to ttl_in_days (1..100000)

  verbose_feeds: true

  supported_types:
    ipv4:   true
    domain: true
    url:    true
    md5:    true
    sha1:   true
    sha256: true

  # Shadow filter: skip subdomains whose parent is being sent, since CP
  # absorbs certain subdomain patterns into their parent record.
  shadowing:
    enabled: true
    prefixes:
      - "www."

  cleanup:
    enabled: false
    max_delete_per_run: 500

filters:
  exclude_expired: true

output:
  directory: "./exports"
  raw_json_prefix: "defender_threat_indicators_raw"
  csv_prefix: "defender_threat_indicators"
  txt_prefix: "defender_threat_indicators"
  summary_prefix: "run_summary"
  uncreated_prefix: "uncreated_indicators"
  state_file: "cp_ioc_state.json"

logging:
  level: "INFO"
  debug_http: true
